# OpenRouter AI Configuration (Backend only - never expose to frontend)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# AI Routing Mode:
# 'auto' (default) -> Dynamically routes to the best free OpenRouter model per task with automatic fallback
# 'manual' -> Always uses OPENROUTER_MODEL if set
AI_ROUTING_MODE=auto

# Optional override model (leave blank to let the AI Router pick the best free model dynamically)
OPENROUTER_MODEL=

PORT=3000
